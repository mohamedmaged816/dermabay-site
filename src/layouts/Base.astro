---
import '@/styles/theme.css';
import Seo from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import ActionBar from '@/components/ActionBar.astro';
import BookDrawer from '@/components/BookDrawer.astro';
import { ClientRouter } from 'astro:transitions';
import { dirOf, withBase, type Lang } from '@/i18n/utils';
import { clinicSchema } from '@/lib/schema';
import manifest from '@/styles/fonts-manifest.json';

interface Props { lang: Lang; title: string; description: string; jsonLd?: Record<string, any>[]; noindex?: boolean; waService?: string; }
const { lang, title, description, jsonLd = [], noindex = false, waService } = Astro.props;
const site = Astro.site!.toString().replace(/\/$/, '');
const GA = import.meta.env.PUBLIC_GA_ID as string | undefined;
const PIXEL = import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined;
type FontEntry = { fam: string; weight: number; style: string; url: string; latin: boolean; arabic: boolean };
const faces = (manifest as FontEntry[]);
const pick = (fam: string, script: 'latin' | 'arabic') => faces.find((f) => f.fam === fam && f.weight === 400 && f.style === 'normal' && f[script])?.url;
const preload = (lang === 'ar' ? [pick('Reem Kufi', 'arabic'), pick('Cairo', 'arabic')] : [pick('Italiana', 'latin'), pick('Quicksand', 'latin')]).filter(Boolean) as string[];
---
<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#2d2d23" />
    <Seo {lang} {title} {description} jsonLd={[clinicSchema(site, lang), ...jsonLd]} {noindex} />
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />
    <ClientRouter />
    {preload.map((u) => <link rel="preload" as="font" type="font/woff2" href={withBase(u)} crossorigin />)}
    {GA && <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA}`}></script>}
    {GA && <script is:inline define:vars={{ GA }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);} window.gtag = gtag;
      gtag('js', new Date()); gtag('config', GA, { anonymize_ip: true });
    </script>}
    {PIXEL && <script is:inline define:vars={{ PIXEL }}>
      !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', PIXEL); fbq('track', 'PageView');
    </script>}
  </head>
  <body class="min-h-screen flex flex-col pb-[76px] sm:pb-0">
    <div class="spot" aria-hidden="true"></div>
    <Header {lang} />
    <main class="flex-1"><slot /></main>
    <Footer {lang} />
    <ActionBar {lang} />
    <BookDrawer {lang} service={waService} />
    <div class="grain" aria-hidden="true"></div>
    <script is:inline>
      (function () {
        var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        function initReveal() {
          if (!('IntersectionObserver' in window) || reduced) return;
          var els = document.querySelectorAll('main > section:not(:first-of-type):not(.reveal), main > div:not(.reveal), footer:not(.reveal)');
          var io = new IntersectionObserver(function (entries) { entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); } }); }, { rootMargin: '0px 0px -8% 0px', threshold: 0.05 });
          els.forEach(function (el) { el.classList.add('reveal'); io.observe(el); });
          setTimeout(function () { els.forEach(function (el) { el.classList.add('is-visible'); }); }, 2500);
        }
        function initCounters() {
          document.querySelectorAll('[data-count]').forEach(function (el) {
            var n = parseInt(el.getAttribute('data-count'), 10) || 0; var start = null;
            function step(ts) { if (!start) start = ts; var p = Math.min(1, (ts - start) / 900); el.textContent = String(Math.round(p * n)).padStart(2, '0'); if (p < 1) requestAnimationFrame(step); }
            if (reduced) { el.textContent = String(n).padStart(2, '0'); return; }
            var io = new IntersectionObserver(function (en) { if (en[0].isIntersecting) { requestAnimationFrame(step); io.disconnect(); } }); io.observe(el);
          });
        }
        function init() { initReveal(); initCounters(); }
        document.addEventListener('astro:page-load', init);
        if (!window.__dbBound) {
          window.__dbBound = true;
          // spotlight
          if (matchMedia('(hover: hover)').matches && !reduced) {
            document.addEventListener('pointermove', function (e) { document.documentElement.style.setProperty('--mx', e.clientX + 'px'); document.documentElement.style.setProperty('--my', e.clientY + 'px'); }, { passive: true });
          }
          // magnetic buttons
          if (matchMedia('(hover: hover)').matches && !reduced) {
            document.addEventListener('pointermove', function (e) {
              var b = e.target && e.target.closest ? e.target.closest('.btn') : null; if (!b) return;
              var r = b.getBoundingClientRect(); var dx = (e.clientX - (r.left + r.width / 2)) / r.width; var dy = (e.clientY - (r.top + r.height / 2)) / r.height;
              b.style.transform = 'translate(' + (dx * 8) + 'px,' + (dy * 8) + 'px)';
            }, { passive: true });
            document.addEventListener('pointerout', function (e) { var b = e.target && e.target.closest ? e.target.closest('.btn') : null; if (b) b.style.transform = ''; }, { passive: true });
          }
          // treatment index hover
          document.addEventListener('pointerover', function (e) {
            var row = e.target && e.target.closest ? e.target.closest('[data-tx]') : null; if (!row) return;
            var i = row.getAttribute('data-tx'); var root = row.closest('#treatments'); if (!root) return;
            root.querySelectorAll('[data-tx]').forEach(function (r) { r.classList.toggle('is-active', r === row); });
            root.querySelectorAll('[data-tx-pane]').forEach(function (p) { p.classList.toggle('is-active', p.getAttribute('data-tx-pane') === i); });
          }, { passive: true });
          // concern finder
          document.addEventListener('click', function (e) {
            var chip = e.target && e.target.closest ? e.target.closest('[data-finder-chip]') : null; if (!chip) return;
            var root = chip.closest('#finder'); var i = chip.getAttribute('data-finder-chip');
            root.querySelectorAll('[data-finder-chip]').forEach(function (c) { c.setAttribute('aria-selected', c === chip ? 'true' : 'false'); });
            root.querySelectorAll('[data-finder-panel]').forEach(function (p) { p.classList.toggle('hidden', p.getAttribute('data-finder-panel') !== i); });
          });
          // booking drawer
          function buildWa() {
            var d = document.getElementById('book'); if (!d) return;
            var slot = d.querySelector('[data-slot][aria-pressed="true"]'); var label = slot ? slot.getAttribute('data-slot-label') : '';
            var svc = d.getAttribute('data-service'); var ar = d.getAttribute('data-lang') === 'ar';
            var msg = ar ? ('أهلاً ديرما باي، عايز/ة أحجز استشارة' + (svc ? ' لـ ' + svc : '') + (label ? '، ويفضل ' + label : '') + '. شفتكم على الموقع.')
                         : ("Hi DermaBay, I'd like to book a consultation" + (svc ? ' for ' + svc : '') + (label ? ', preferably in the ' + label.toLowerCase() : '') + '. I found you on your website.');
            var go = d.querySelector('[data-book-go]'); go.href = 'https://wa.me/' + d.getAttribute('data-phone').replace(/\D/g, '') + '?text=' + encodeURIComponent(msg);
          }
          document.addEventListener('click', function (e) {
            var t = e.target && e.target.closest ? e.target : null; if (!t) return;
            if (t.closest('[data-book-open]')) { var d = document.getElementById('book'); if (d && d.showModal) { buildWa(); d.showModal(); } }
            var slot = t.closest('[data-slot]'); if (slot) { slot.parentElement.querySelectorAll('[data-slot]').forEach(function (s) { s.setAttribute('aria-pressed', s === slot ? 'true' : 'false'); }); buildWa(); }
            if (t.closest('[data-book-go]')) { var dd = document.getElementById('book'); setTimeout(function () { dd && dd.close(); }, 150); }
            var dlg = t.closest('dialog.drawer'); if (dlg && t === dlg) dlg.close();
          });
        }
        if (document.readyState !== 'loading') init(); else document.addEventListener('DOMContentLoaded', init);
      })();
    </script>
    <script is:inline>
      document.addEventListener('click', function (e) {
        var a = e.target && e.target.closest ? e.target.closest('a[data-wa]') : null;
        if (!a) return;
        var payload = { service: a.getAttribute('data-wa') || 'general', page: location.pathname, lang: document.documentElement.lang };
        if (window.gtag) window.gtag('event', 'whatsapp_click', payload);
        if (window.fbq) window.fbq('track', 'Contact', payload);
      });
    </script>
  </body>
</html>
