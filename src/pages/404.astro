---
import Base from '@/layouts/Base.astro';
import Wordmark from '@/components/Wordmark.astro';
import { t } from '@/i18n/ui';
import { localizePath } from '@/i18n/utils';
const T = t('en'); const A = t('ar');
---
<Base lang="en" title={T('notfound_title')} description={`${T('notfound_sub')} DermaBay dermatology and laser clinic, New Giza.`} noindex>
  <section class="container-x flex flex-col items-center py-24 text-center">
    <Wordmark size={4} tone="gold" />
    <h1 class="font-display mt-10 text-5xl text-cream">{T('notfound_title')}</h1>
    <p class="mt-3 text-cream/60">{T('notfound_sub')}</p>
    <p class="font-display mt-6 text-3xl text-cream" lang="ar" dir="rtl">{A('notfound_title')}</p>
    <div class="mt-10 flex justify-center gap-3">
      <a href={localizePath('/', 'en')} class="btn-cream">{T('notfound_home')}</a>
      <a href={localizePath('/', 'ar')} class="btn-outline" lang="ar">{A('notfound_home')}</a>
    </div>
  </section>
</Base>
