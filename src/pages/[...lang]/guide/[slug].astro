---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Summary from '@/components/Summary.astro';
import FAQ from '@/components/FAQ.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Leaves from '@/components/Leaves.astro';
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { articleSchema, breadcrumbSchema, faqSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const all = await getCollection('guide');
  return all.map((entry) => ({ params: { lang: entry.data.lang === 'en' ? undefined : 'ar', slug: entry.data.slug }, props: { entry, lang: entry.data.lang as Lang } }));
}
const { entry, lang } = Astro.props;
const d = entry.data;
const T = t(lang);
const site = Astro.site!.toString().replace(/\/$/, '');
const url = site + localizePath(`guide/${d.slug}`, lang);
const { Content } = await render(entry);
const service = d.service ? await getEntry('services', `${lang}/${d.service}`) : null;
const crumbs = [
  { name: T('breadcrumb_home'), href: localizePath('/', lang) },
  { name: T('nav_guide'), href: localizePath('guide', lang) },
  { name: d.title, href: localizePath(`guide/${d.slug}`, lang) },
];
const jsonLd: Record<string, any>[] = [
  articleSchema({ headline: d.title, description: d.description, url, datePublished: d.date.toISOString().slice(0, 10), lang }, site),
  breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: site + c.href }))),
];
if (d.faqs.length) jsonLd.push(faqSchema(d.faqs));
const fmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-EG' : 'en-GB', { dateStyle: 'long' });
---
<Base {lang} title={d.title} description={d.description} {jsonLd} waService={service?.data.title}>
  <Breadcrumbs items={crumbs} />
  <section class="relative overflow-hidden pb-14 pt-10">
    <Leaves opacity={0.45} />
    <div class="container-x relative max-w-3xl">
      <p class="label">{T('nav_guide')} · {fmt.format(d.date)}</p>
      <h1 class="font-display mt-5 text-4xl leading-[1.02] text-cream sm:text-6xl">{d.title}</h1>
    </div>
  </section>
  <Summary {lang} text={d.summary} />
  <section class="mt-12 bg-cream text-ink">
    <article class="container-x prose-clinic max-w-3xl py-14"><Content /></article>
    {service && (
      <div class="container-x max-w-3xl pb-14">
        <a href={localizePath(`services/${service.data.slug}`, lang)} class="flex items-center justify-between gap-6 rounded-[24px] bg-sand p-6 transition hover:bg-paper">
          <div>
            <p class="label-ink">{T('nav_services')}</p>
            <p class="font-display mt-2 text-2xl text-forest">{service.data.title}</p>
            <p class="mt-1 text-sm text-ink/70">{service.data.description}</p>
          </div>
          <span class="font-display text-3xl text-gold-deep" aria-hidden="true">→</span>
        </a>
      </div>
    )}
  </section>
  {d.faqs.length > 0 && <FAQ {lang} faqs={d.faqs} />}
  <CtaBand {lang} service={service?.data.title} />
</Base>
