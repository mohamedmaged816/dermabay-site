---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { langPaths, localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const guides = (await getCollection('guide', (e) => e.data.lang === lang)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const title = lang === 'ar' ? 'دليل البشرة: إجابات من دكتور جلدية' : 'Skin Guide: straight answers from a dermatology clinic';
const description = lang === 'ar' ? 'مقالات قصيرة بتجاوب على أسئلة الناس الحقيقية عن الليزر والتصبغات وحب الشباب وتساقط الشعر، من عيادة ديرما باي نيو جيزة.' : 'Short articles answering real questions about laser, pigmentation, acne and hair loss, from DermaBay clinic in New Giza.';
const crumbs = [{ name: T('breadcrumb_home'), href: localizePath('/', lang) }, { name: T('nav_guide'), href: localizePath('guide', lang) }];
const fmt = new Intl.DateTimeFormat(lang === 'ar' ? 'ar-EG' : 'en-GB', { dateStyle: 'medium' });
---
<Base {lang} {title} {description}>
  <Breadcrumbs items={crumbs} />
  <Hero {lang} compact eyebrow={T('nav_guide')} title={T('guide_title')} sub={T('guide_sub')} />
  <section class="container-x grid gap-5 md:grid-cols-2">
    {guides.map((g, i) => (
      <a href={localizePath(`guide/${g.data.slug}`, lang)} class={`group ${i % 3 === 0 ? 'panel' : 'rounded-[28px] border border-cream/15 hover:border-gold'} p-8 transition`}>
        <p class={`text-[11px] uppercase tracking-[0.2em] ${i % 3 === 0 ? 'text-gold-deep' : 'text-cream/70'}`}>{fmt.format(g.data.date)}</p>
        <h2 class={`font-display mt-4 text-3xl leading-[1.08] ${i % 3 === 0 ? 'text-forest' : 'text-cream group-hover:text-gold'}`}>{g.data.title}</h2>
        <p class={`mt-4 leading-relaxed ${i % 3 === 0 ? 'text-ink/70' : 'text-cream/60'}`}>{g.data.description}</p>
      </a>
    ))}
  </section>
  <CtaBand {lang} />
</Base>
