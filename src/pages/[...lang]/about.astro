---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Summary from '@/components/Summary.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Wordmark from '@/components/Wordmark.astro';
import { langPaths, localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const title = lang === 'ar' ? 'عن ديرما باي' : 'About DermaBay';
const description = lang === 'ar' ? 'ديرما باي: أول عيادة جلدية وشعر في نيو جيزة. طب أولاً، أجهزة معتمدة، وخطة واضحة لكل عميل.' : 'DermaBay: the first skin and hair clinic in New Giza. Medicine first, certified devices, and a clear plan for every patient.';
const summary = lang === 'ar'
  ? 'ديرما باي عيادة جلدية وتجميل وشعر اتأسست في ميديتاون، نيو جيزة، عشان تخدم غرب القاهرة بمستوى طبي محترم من غير مبالغة. كل علاج بيبدأ بتشخيص، وكل خطة بتتكتب بعدد الجلسات والسعر.'
  : 'DermaBay is a dermatology, aesthetic and hair clinic founded at Meditown, New Giza, to serve West Cairo with a proper medical standard and no hype. Every treatment starts with a diagnosis, and every plan is written down with sessions and price.';
const blocks: [string, string][] = lang === 'ar' ? [
  ['الطب قبل الجهاز', 'عندنا أجهزة ليزر وفراكشنال حديثة (منها Tetra Pro)، بس الجهاز مش هو اللي بيعالج. التشخيص الصح وإعدادات مناسبة لبشرتك هما اللي بيفرقوا، وده اللي بنركز عليه.'],
  ['صراحة في التوقعات', 'لو علاج مش هيديك نتيجة، هنقولك. لو محتاج 6 جلسات مش 3، هنقولك من الأول. سمعتنا في نيو جيزة أهم من أي حجز.'],
  ['نظافة ومعايير', 'تعقيم بين كل عميل، أدوات استخدام واحد حيث يلزم، ومتابعة بعد الجلسة على واتساب.'],
  ['فريق العيادة', 'صفحة تعريفية بأطباء العيادة وشهاداتهم جاية قريب.'],
] : [
  ['Medicine before machines', 'We run modern laser and fractional devices (including Tetra Pro), but the device is not what treats you. The right diagnosis and settings matched to your skin are what make the difference, and that is what we focus on.'],
  ['Honest expectations', "If a treatment won't give you a result, we say so. If you need 6 sessions rather than 3, you hear it on day one. Our reputation in New Giza matters more than any single booking."],
  ['Hygiene and standards', 'Sterilisation between every patient, single-use consumables where required, and WhatsApp follow-up after each session.'],
  ['The clinic team', 'A page introducing our doctors and their credentials is coming soon.'],
];
const crumbs = [{ name: T('breadcrumb_home'), href: localizePath('/', lang) }, { name: T('nav_about'), href: localizePath('about', lang) }];
---
<Base {lang} {title} {description}>
  <Breadcrumbs items={crumbs} />
  <Hero {lang} compact shape="pill" wordmark image="room-portrait" imageAlt={lang === 'ar' ? 'عيادة ديرما باي من الداخل' : 'Inside DermaBay clinic'} eyebrow={T('nav_about')} title={T('about_title')} sub={description} />
  <Summary {lang} text={summary} />
  <section class="container-x mt-16 grid gap-5 md:grid-cols-2">
    {blocks.map(([h, p], i) => (
      <div class={`rounded-[28px] p-8 ${i % 2 === 0 ? 'panel' : 'border border-cream/15'}`}>
        <span class={`font-display text-4xl ${i % 2 === 0 ? 'text-gold-deep' : 'text-gold'}`}>{String(i + 1).padStart(2, '0')}</span>
        <h2 class={`font-display mt-5 text-3xl ${i % 2 === 0 ? 'text-forest' : 'text-cream'}`}>{h}</h2>
        <p class={`mt-3 leading-[1.75] ${i % 2 === 0 ? 'text-ink/80' : 'text-cream/65'}`}>{p}</p>
      </div>
    ))}
  </section>
  <div class="container-x mt-24 flex justify-center"><Wordmark size={7} tone="cream" class="opacity-15" /></div>
  <CtaBand {lang} />
</Base>
