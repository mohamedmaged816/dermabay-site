---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Summary from '@/components/Summary.astro';
import FAQ from '@/components/FAQ.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BeforeAfter from '@/components/BeforeAfter.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { breadcrumbSchema, faqSchema, procedureSchema } from '@/lib/schema';

export async function getStaticPaths() {
  const all = await getCollection('services');
  return all.map((entry) => ({
    params: { lang: entry.data.lang === 'en' ? undefined : 'ar', slug: entry.data.slug },
    props: { entry, lang: entry.data.lang as Lang },
  }));
}
const { entry, lang } = Astro.props;
const d = entry.data;
const T = t(lang);
const site = Astro.site!.toString().replace(/\/$/, '');
const url = site + localizePath(`services/${d.slug}`, lang);
const { Content } = await render(entry);
const related = await getCollection('guide', (g) => g.data.lang === lang && d.related.includes(g.data.slug));
const crumbs = [
  { name: T('breadcrumb_home'), href: localizePath('/', lang) },
  { name: T('nav_services'), href: localizePath('services', lang) },
  { name: d.title, href: localizePath(`services/${d.slug}`, lang) },
];
const jsonLd = [
  procedureSchema({ name: d.title, description: d.description, url }, site),
  faqSchema(d.faqs),
  breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: site + c.href }))),
];
const heroImage = ({ 'laser-hair-removal': 'handpiece-portrait', 'fractional-laser-scars': 'device-portrait', 'laser-skin-rejuvenation': 'device-portrait', 'pigmentation-melasma': 'device-portrait', 'skin-boosters': 'device-square', 'acne-medical-dermatology': 'room-square' } as Record<string, string>)[d.slug] ?? 'room-portrait';
const heroShape = ({ 'fractional-laser-scars': 'pill', 'non-surgical-rejuvenation': 'pill', 'hair-loss': 'pill', 'skin-boosters': 'circle', 'acne-medical-dermatology': 'circle' } as Record<string, 'arch' | 'pill' | 'circle'>)[d.slug] ?? 'arch';
const heroAlt = lang === 'ar' ? `${d.title} في عيادة ديرما باي` : `${d.title} at DermaBay`;
const facts: [string, string][] = [
  [T('svc_sessions'), d.sessions],
  [T('svc_downtime'), d.downtime],
  [T('svc_results'), d.results],
  [T('svc_price'), d.price ?? T('svc_price_ask')],
];
---
<Base {lang} title={d.metaTitle} description={d.description} {jsonLd} waService={d.title}>
  <Breadcrumbs items={crumbs} />
  <Hero {lang} compact image={heroImage} shape={heroShape} imageAlt={heroAlt} eyebrow={`${T('nav_services')} · ${String(d.order).padStart(2, '0')}`} title={d.title} sub={d.description} service={d.title} />
  <Summary {lang} text={d.summary} />

  <section class="mt-16 bg-cream text-ink">
    <div class="container-x grid gap-10 py-10 sm:py-16 lg:grid-cols-[1fr_340px]">
      <div>
        <div class="grid gap-10 sm:grid-cols-2">
          <div>
            <p class="label-ink">{T('svc_for')}</p>
            <ul class="mt-4 space-y-3">{d.forWho.map((x) => <li class="flex gap-3 leading-relaxed text-ink/85"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gold-deep"></span><span>{x}</span></li>)}</ul>
          </div>
          {d.notFor.length > 0 && (
            <div>
              <p class="label-ink">{T('svc_notfor')}</p>
              <ul class="mt-4 space-y-3">{d.notFor.map((x) => <li class="flex gap-3 leading-relaxed text-ink/70"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full border border-forest/40"></span><span>{x}</span></li>)}</ul>
            </div>
          )}
        </div>

        <p class="label-ink mt-14">{T('svc_session')}</p>
        <ol class="mt-5 divide-y divide-forest/10 border-y border-forest/10">
          {d.session.map((x, i) => <li class="flex gap-5 py-4"><span class="font-display text-2xl leading-none text-gold-deep">{String(i + 1).padStart(2, '0')}</span><span class="leading-relaxed text-ink/85">{x}</span></li>)}
        </ol>

        <div class="prose-clinic mt-6"><Content /></div>
      </div>

      <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
        {facts.map(([h, v]) => (
          <div class="rounded-[24px] bg-sand p-6">
            <p class="label-ink">{h}</p>
            <p class="mt-2 leading-relaxed text-ink/85">{v}</p>
          </div>
        ))}
        <div class="pt-2"><WhatsAppButton {lang} service={d.title} tone="forest" /></div>
      </aside>
    </div>
  </section>

  <section class="container-x mt-24">
    <p class="label">{T('nav_results')}</p>
    <h2 class="font-display mt-3 text-3xl text-cream sm:text-4xl">{T('results_title')}</h2>
    <div class="mt-8"><BeforeAfter {lang} service={d.slug} /></div>
  </section>

  <FAQ {lang} faqs={d.faqs} title={T('svc_faq')} />

  {related.length > 0 && (
    <section class="container-x mt-24">
      <p class="label">{T('svc_related')}</p>
      <ul class="mt-6 grid gap-4 sm:grid-cols-2">
        {related.map((g) => <li><a href={localizePath(`guide/${g.data.slug}`, lang)} class="group block rounded-[24px] border border-cream/15 p-6 transition hover:border-gold"><span class="font-display text-xl leading-tight text-cream group-hover:text-gold">{g.data.title}</span><br/><span class="mt-2 block text-sm text-cream/60">{g.data.description}</span></a></li>)}
      </ul>
    </section>
  )}

  <CtaBand {lang} service={d.title} />
</Base>
