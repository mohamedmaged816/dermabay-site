---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import WhatsAppButton from '@/components/WhatsAppButton.astro';
import Wordmark from '@/components/Wordmark.astro';
import { langPaths, localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { offer } from '@/data/offers';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const title = lang === 'ar' ? 'عروض ديرما باي الحالية' : 'Current DermaBay offers';
const description = lang === 'ar' ? 'العرض الحالي في عيادة ديرما باي نيو جيزة. عرض واحد واضح، والسعر بيتأكد على واتساب قبل الحجز.' : 'The current offer at DermaBay New Giza. One clear offer, price confirmed on WhatsApp before you book.';
const crumbs = [{ name: T('breadcrumb_home'), href: localizePath('/', lang) }, { name: T('nav_offers'), href: localizePath('offers', lang) }];
---
<Base {lang} {title} {description} waService={offer.title[lang]}>
  <Breadcrumbs items={crumbs} />
  <Hero {lang} compact image="handpiece-portrait" imageAlt={lang === 'ar' ? 'جهاز الليزر ونضارة الحماية' : 'Laser handpiece and protective goggles'} eyebrow={T('nav_offers')} title={T('offers_title')} sub={T('offers_sub')} service={offer.title[lang]} />
  {offer.active && (
    <section class="container-x">
      <div class="panel-sand grid items-center gap-10 overflow-hidden p-8 sm:p-14 md:grid-cols-[1fr_auto]">
        <div>
          <p class="label-ink">{T('offers_title')}</p>
          <h2 class="font-display mt-4 text-4xl text-forest sm:text-6xl">{offer.title[lang]}</h2>
          <p class="mt-6 max-w-2xl text-lg leading-[1.75] text-ink/85">{offer.body[lang]}</p>
          <p class="mt-5 text-sm text-ink/55">{offer.terms[lang]}</p>
          <div class="mt-8"><WhatsAppButton {lang} service={offer.title[lang]} tone="forest" /></div>
        </div>
        <Wordmark size={5} tone="forest" class="hidden opacity-20 md:block" />
      </div>
    </section>
  )}
  <CtaBand {lang} service={offer.title[lang]} />
</Base>
