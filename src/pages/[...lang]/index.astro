---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Summary from '@/components/Summary.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ReviewStrip from '@/components/ReviewStrip.astro';
import Map from '@/components/Map.astro';
import CtaBand from '@/components/CtaBand.astro';
import Wordmark from '@/components/Wordmark.astro';
import Marquee from '@/components/Marquee.astro';
import InstagramStrip from '@/components/InstagramStrip.astro';
import { langPaths, localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
import { offer } from '@/data/offers';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const services = (await getCollection('services', (e) => e.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guide', (e) => e.data.lang === lang)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const summary = lang === 'ar'
  ? `ديرما باي عيادة جلدية وشعر وليزر في ميديتاون، نيو جيزة هيلث بارك (مبنى 2، عيادة 203)، بتخدم نيو جيزة والشيخ زايد و6 أكتوبر. الحجز على واتساب ${clinic.phoneDisplay}.`
  : `DermaBay is a dermatology, hair and laser clinic at Meditown, NewGiza Health Park (Building 2, Clinic 203), serving New Giza, Sheikh Zayed and 6th of October. Book on WhatsApp at ${clinic.phoneDisplay}.`;
const title = lang === 'ar' ? 'ديرما باي | عيادة جلدية وليزر في نيو جيزة' : 'DermaBay | Dermatology & Laser Clinic in New Giza';
const description = lang === 'ar'
  ? 'أول عيادة جلدية وشعر في نيو جيزة، ميديتاون. ليزر، علاج التصبغات، نضارة البشرة، وجلدية طبية. احجز على واتساب.'
  : 'The first skin & hair clinic in New Giza, Meditown. Laser hair removal, pigmentation, skin boosters and medical dermatology. Book on WhatsApp.';
---
<Base {lang} {title} {description}>
  <Hero {lang} wordmark eyebrow={T('home_eyebrow')} title={T('home_h1')} sub={T('home_sub')} secondaryHref={localizePath('services', lang)} secondaryLabel={T('see_all_services')} />
  <Marquee items={services.map((s) => s.data.title)} />
  <div class="mt-16"><Summary {lang} text={summary} /></div>

  <section class="container-x mt-28">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="label">{T('nav_services')}</p>
        <h2 class="font-display mt-3 text-4xl text-cream sm:text-5xl">{T('home_services_title')}</h2>
      </div>
      <p class="max-w-sm text-cream/60">{T('home_services_sub')}</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {services.slice(0, 4).map((s, i) => <ServiceCard {lang} index={i + 1} slug={s.data.slug} title={s.data.title} description={s.data.description} icon={s.data.icon} />)}
    </div>
    <div class="mt-8"><a href={localizePath('services', lang)} class="btn-outline">{T('see_all_services')}</a></div>
  </section>

  {offer.active && (
    <section class="container-x mt-28">
      <a href={localizePath('offers', lang)} class="panel-sand relative block overflow-hidden p-8 transition hover:bg-paper sm:p-12">
        <div class="grid items-center gap-8 md:grid-cols-[1fr_auto]">
          <div>
            <p class="label-ink">{T('offers_title')}</p>
            <h2 class="font-display mt-4 text-4xl text-forest sm:text-5xl">{offer.title[lang]}</h2>
            <p class="mt-4 max-w-2xl leading-[1.75] text-ink/80">{offer.body[lang]}</p>
          </div>
          <span class="btn-forest">{T('book_whatsapp')}</span>
        </div>
      </a>
    </section>
  )}

  <section class="container-x mt-28">
    <p class="label">{T('home_why_title')}</p>
    <div class="mt-8 grid gap-px overflow-hidden rounded-[28px] border border-cream/10 bg-cream/10 md:grid-cols-3">
      {(T('home_why') as [string, string][]).map(([h, p], i) => (
        <div class="bg-forest p-8">
          <span class="font-display text-6xl text-sand">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="font-display mt-6 text-2xl text-cream">{h}</h3>
          <p class="mt-3 leading-relaxed text-cream/65">{p}</p>
        </div>
      ))}
    </div>
  </section>

  <ReviewStrip {lang} />

  {guides.length > 0 && (
    <section class="container-x mt-28">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="label">{T('nav_guide')}</p>
          <h2 class="font-display mt-3 text-4xl text-cream">{T('home_guide_title')}</h2>
        </div>
        <a href={localizePath('guide', lang)} class="btn-outline">{T('guide_title')}</a>
      </div>
      <div class="mt-8 grid gap-5 md:grid-cols-3">
        {guides.map((g) => (
          <a href={localizePath(`guide/${g.data.slug}`, lang)} class="group rounded-[28px] border border-cream/15 p-7 transition hover:border-gold">
            <h3 class="font-display text-2xl leading-tight text-cream group-hover:text-gold">{g.data.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-cream/60">{g.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <InstagramStrip {lang} />

  <section class="container-x mt-28 grid items-center gap-10 lg:grid-cols-[auto_1fr]">
    <div class="flex items-end gap-6">
      <Wordmark size={4} tone="gold" class="hidden sm:block" />
      <div>
        <p class="label">{T('location_eyebrow')}</p>
        <h2 class="font-display mt-3 text-4xl text-cream">{T('nav_location')}</h2>
        <p class="mt-3 max-w-xs text-cream/60">{clinic.address[lang].line1}, {clinic.address[lang].line2}</p>
      </div>
    </div>
    <Map {lang} />
  </section>

  <CtaBand {lang} />
</Base>
