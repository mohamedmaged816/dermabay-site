---
import { getCollection } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Summary from '@/components/Summary.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ReviewStrip from '@/components/ReviewStrip.astro';
import Map from '@/components/Map.astro';
import CtaBand from '@/components/CtaBand.astro';
import Wordmark from '@/components/Wordmark.astro';
import Marquee from '@/components/Marquee.astro';
import InstagramStrip from '@/components/InstagramStrip.astro';
import StatementPlate from '@/components/StatementPlate.astro';
import ConcernFinder from '@/components/ConcernFinder.astro';
import PhotoBand from '@/components/PhotoBand.astro';
import TreatmentIndex from '@/components/TreatmentIndex.astro';
import BigType from '@/components/BigType.astro';
import { langPaths, localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
import { offer } from '@/data/offers';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const services = (await getCollection('services', (e) => e.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const guides = (await getCollection('guide', (e) => e.data.lang === lang)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const summary = lang === 'ar'
  ? `ديرما باي عيادة جلدية وشعر وليزر في ميديتاون، نيو جيزة هيلث بارك (مبنى 2، عيادة 203)، بتخدم نيو جيزة والشيخ زايد و6 أكتوبر. الحجز على واتساب ${clinic.phoneDisplay}.`
  : `DermaBay is a dermatology, hair and laser clinic at Meditown, NewGiza Health Park (Building 2, Clinic 203), serving New Giza, Sheikh Zayed and 6th of October. Book on WhatsApp at ${clinic.phoneDisplay}.`;
const title = lang === 'ar' ? 'ديرما باي | عيادة جلدية وليزر في نيو جيزة' : 'DermaBay | Dermatology & Laser Clinic in New Giza';
const description = lang === 'ar'
  ? 'أول عيادة جلدية وشعر في نيو جيزة، ميديتاون. ليزر، علاج التصبغات، نضارة البشرة، وجلدية طبية. احجز على واتساب.'
  : 'The first skin & hair clinic in New Giza, Meditown. Laser hair removal, pigmentation, skin boosters and medical dermatology. Book on WhatsApp.';
---
<Base {lang} {title} {description}>
  <Hero {lang} wordmark image="device-portrait" imageAlt={lang === 'ar' ? 'جهاز الليزر في عيادة ديرما باي' : 'The laser platform at DermaBay'} eyebrow={T('home_eyebrow')} title={T('home_h1')} sub={T('home_sub')} secondaryHref={localizePath('services', lang)} secondaryLabel={T('see_all_services')} />
  <Marquee items={services.map((s) => s.data.title)} />
  <StatementPlate {lang} />
  <div class="mt-24"><Summary {lang} text={summary} /></div>
  <ConcernFinder {lang} />

  <TreatmentIndex {lang} />

  {offer.active && (
    <section class="mt-28 bg-sand text-ink">
      <a href={localizePath('offers', lang)} class="container-x block py-14 transition hover:opacity-90 sm:py-20">
        <div class="grid items-end gap-8 md:grid-cols-[1fr_auto]">
          <div>
            <p class="label-ink">{T('offers_title')}</p>
            <h2 class="font-display mt-3 text-3xl text-forest sm:text-6xl">{offer.title[lang]}</h2>
            <p class="mt-5 max-w-2xl leading-[1.75] text-ink/80">{offer.body[lang]}</p>
          </div>
          <span class="btn-forest">{T('book_whatsapp')}</span>
        </div>
      </a>
    </section>
  )}

  <section class="container-x mt-28">
    <p class="label-quiet">{T('home_why_title')}</p>
    <div class="mt-10 grid gap-12 md:grid-cols-3 md:gap-10">
      {(T('home_why') as [string, string][]).map(([h, p], i) => (
        <div>
          <span class="font-display text-6xl text-sand sm:text-7xl" data-count={i + 1}>00</span>
          <div class="hairline-gold mt-5 !w-10"></div>
          <h3 class="font-display mt-5 text-3xl text-cream">{h}</h3>
          <p class="mt-3 max-w-xs leading-[1.8] text-cream/65">{p}</p>
        </div>
      ))}
    </div>
  </section>

  <BigType {lang} />

  <PhotoBand {lang} />

  <ReviewStrip {lang} />

  {guides.length > 0 && (
    <section class="container-x mt-28">
      <div class="md:ms-auto md:w-2/3">
        <p class="label-quiet">{T('nav_guide')}</p>
        <h2 class="font-display mt-3 text-3xl text-cream sm:text-5xl">{T('home_guide_title')}</h2>
        <div class="mt-8 divide-y divide-cream/10 border-y border-cream/10">
          {guides.map((g) => (
            <a href={localizePath(`guide/${g.data.slug}`, lang)} class="group flex items-start justify-between gap-6 py-6 text-cream transition hover:text-sand">
              <span>
                <span class="font-display block text-2xl leading-tight sm:text-3xl">{g.data.title}</span>
                <span class="mt-2 block max-w-xl text-sm leading-relaxed text-cream/60">{g.data.description}</span>
              </span>
              <svg class="mt-2 h-6 w-6 shrink-0 transition group-hover:translate-x-2 rtl:-scale-x-100 rtl:group-hover:-translate-x-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
            </a>
          ))}
        </div>
        <a href={localizePath('guide', lang)} class="btn-outline mt-8">{T('guide_title')}</a>
      </div>
    </section>
  )}

  <InstagramStrip {lang} />

  <section class="container-x mt-28 grid items-center gap-10 lg:grid-cols-[auto_1fr]">
    <div class="flex items-end gap-6">
      <Wordmark size={4} tone="gold" class="hidden sm:block" />
      <div>
        <p class="label-quiet">{T('location_eyebrow')}</p>
        <h2 class="font-display mt-3 text-3xl text-cream sm:text-4xl">{T('nav_location')}</h2>
        <p class="mt-3 max-w-xs text-cream/60">{clinic.address[lang].line1}, {clinic.address[lang].line2}</p>
      </div>
    </div>
    <Map {lang} />
  </section>

  <CtaBand {lang} />
</Base>
