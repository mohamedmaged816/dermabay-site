---
import Base from '@/layouts/Base.astro';
import Hero from '@/components/Hero.astro';
import Map from '@/components/Map.astro';
import CtaBand from '@/components/CtaBand.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { langPaths, localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
export const getStaticPaths = langPaths;
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const addr = clinic.address[lang];
const title = lang === 'ar' ? 'تواصل مع ديرما باي' : 'Contact DermaBay';
const description = lang === 'ar' ? `عيادة ديرما باي، ميديتاون نيو جيزة، مبنى 2 عيادة 203. واتساب وتليفون ${clinic.phoneDisplay}. احجز استشارتك.` : `DermaBay Clinic, Meditown New Giza, Building 2, Clinic 203. WhatsApp and phone ${clinic.phoneDisplay}. Book your consultation.`;
const crumbs = [{ name: T('breadcrumb_home'), href: localizePath('/', lang) }, { name: T('nav_contact'), href: localizePath('contact', lang) }];
---
<Base {lang} {title} {description}>
  <Breadcrumbs items={crumbs} />
  <Hero {lang} compact shape="circle" image="room-square" imageAlt={lang === 'ar' ? 'غرفة علاج في ديرما باي' : 'A DermaBay treatment room'} eyebrow={T('nav_contact')} title={T('contact_title')} sub={T('cta_sub')} secondaryHref={`tel:${clinic.phoneE164}`} secondaryLabel={`${T('call')} ${clinic.phoneDisplay}`} />
  <section class="container-x grid gap-10 lg:grid-cols-2">
    <div class="grid content-start gap-8">
      <div><p class="label">{T('contact_address')}</p><p class="font-display mt-3 text-2xl leading-snug text-cream">{addr.line1}<br/>{addr.line2}<br/>{addr.city}, {addr.region}, {addr.country}</p></div>
      <div class="hairline"></div>
      <div><p class="label">{T('contact_phone')}</p><p class="font-display mt-3 text-3xl text-cream" dir="ltr"><a href={`tel:${clinic.phoneE164}`} class="hover:text-gold">{clinic.phoneDisplay}</a></p></div>
      <div class="hairline"></div>
      <div><p class="label">{T('contact_hours')}</p><p class="mt-3 text-cream/80">{clinic.hoursText[lang]}</p></div>
      <div class="hairline"></div>
      <div><p class="label">Instagram</p><p class="mt-3"><a href={clinic.instagram} target="_blank" rel="noopener" class="text-cream hover:text-gold">@dermabay.eg</a></p></div>
    </div>
    <Map {lang} />
  </section>
  <CtaBand {lang} />
</Base>
