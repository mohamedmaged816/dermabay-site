---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import Leaves from './Leaves.astro';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
---
<section class="relative mt-24 overflow-hidden bg-terra text-cream">
  <div class="pointer-events-none absolute inset-0 text-terra-deep"><Leaves opacity={0.35} flip /></div>
  <div class="container-x relative py-16 sm:py-32">
    <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-cream/85">{T('belief_label')}</p>
    <h2 class="font-display mt-5 max-w-4xl text-[2rem] leading-[1.12] text-cream sm:text-6xl sm:leading-[1.08]">{T('belief_h2')}</h2>
    <p class="mt-6 max-w-xl text-base leading-[1.8] text-cream/85 sm:text-lg">{T('belief_p')}</p>
  </div>
</section>
