---
import { alternatePath, otherLang, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
const { lang } = Astro.props as { lang: Lang };
const target = otherLang(lang);
const href = alternatePath(Astro.url.pathname, target);
---
<a href={href} hreflang={target} lang={target} class="rounded-full border border-olive/30 px-3 py-1 text-sm font-semibold text-olive hover:border-olive">{t(lang)('lang_switch')}</a>
