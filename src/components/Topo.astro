---
/** Slow-drifting topographic lines, sand on dark. Decorative. */
const { class: cls = '' } = Astro.props as { class?: string };
---
<div class={`pointer-events-none absolute inset-0 overflow-hidden ${cls}`} aria-hidden="true">
  <svg class="topo" viewBox="0 0 1200 800" fill="none" stroke="currentColor" stroke-width="1" preserveAspectRatio="xMidYMid slice">
    {Array.from({ length: 14 }).map((_, i) => {
      const r = 60 + i * 48;
      return <path d={`M ${600 - r * 1.6} 400 C ${600 - r * 1.2} ${400 - r * 1.1}, ${600 + r * 0.9} ${400 - r * 1.3}, ${600 + r * 1.6} ${400 - r * 0.2} S ${600 + r * 0.6} ${400 + r * 1.25}, ${600 - r * 0.8} ${400 + r * 1.05} S ${600 - r * 1.7} ${400 + r * 0.4}, ${600 - r * 1.6} 400 Z`} />;
    })}
  </svg>
</div>
