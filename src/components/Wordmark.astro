---
/** Backwards-compatible wrapper: renders the real stacked logo. `size` is roughly the former type size in rem. */
import Logo from './Logo.astro';
const { size = 3, class: cls = '', tone = 'cream' } = Astro.props as { size?: number; class?: string; tone?: 'cream' | 'forest' | 'gold' | 'sand' | 'terra' };
const color = { cream: 'text-cream', forest: 'text-forest', gold: 'text-sand', sand: 'text-sand', terra: 'text-terra' }[tone] ?? 'text-cream';
---
<span class={`inline-block ${color} ${cls}`} style={`width:${(size * 2.3).toFixed(1)}rem`}><Logo variant="stacked" class="block w-full [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" /></span>
