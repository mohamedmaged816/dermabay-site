---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { buildWhatsAppUrl, waMessage } from '@/lib/whatsapp';
import { clinic } from '@/data/clinic';
interface Props { lang: Lang; service?: string; small?: boolean; floating?: boolean; label?: string; tone?: 'cream' | 'forest' | 'gold' }
const { lang, service, small = false, floating = false, label, tone = 'cream' } = Astro.props;
const href = buildWhatsAppUrl(clinic.whatsapp, waMessage(lang, service));
const text = label ?? t(lang)('book_whatsapp');
const base = tone === 'forest' ? 'btn-forest' : tone === 'gold' ? 'btn bg-gold text-forest hover:bg-gold-light' : 'btn-cream';
const cls = floating
  ? 'fixed bottom-5 end-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-wa text-white shadow-2xl sm:hidden'
  : small ? `${base} !px-4 !py-2 !text-xs` : base;
---
<a href={href} target="_blank" rel="noopener" data-wa={service ?? 'general'} class={cls} aria-label={text}>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.9 11.9 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.4-1.7a11.9 11.9 0 0 0 5.6 1.4c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.3zM12 21.7c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4A9.8 9.8 0 0 1 2.1 12C2.1 6.5 6.5 2 12 2c2.6 0 5.1 1 7 2.9a9.8 9.8 0 0 1 2.9 7c0 5.5-4.5 9.8-9.9 9.8zm5.4-7.3c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5.3-.5c.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4z"/></svg>
  {!floating && <span>{text}</span>}
</a>
