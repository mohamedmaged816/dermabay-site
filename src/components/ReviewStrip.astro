---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
import { reviews } from '@/data/reviews';
const { lang, limit = 3 } = Astro.props as { lang: Lang; limit?: number };
const T = t(lang);
const shown = reviews.slice(0, limit);
---
<section class="container-x mt-24">
  <div class="flex flex-wrap items-end justify-between gap-6">
    <div>
      <p class="label">Google</p>
      <h2 class="font-display mt-3 text-4xl text-cream">{T('reviews_title')}</h2>
      <p class="mt-2 text-cream/60">{T('reviews_sub')}{clinic.rating && <span dir="ltr" class="text-gold"> · {clinic.rating.value.toFixed(1)} ★ ({clinic.rating.count})</span>}</p>
    </div>
    <a href={clinic.mapsUrl} target="_blank" rel="noopener" class="btn-outline">{T('reviews_cta')}</a>
  </div>
  {shown.length > 0 ? (
    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {shown.map((r) => (
        <figure class="panel p-7" lang={r.lang} dir={r.lang === 'ar' ? 'rtl' : 'ltr'}>
          <span class="font-display text-5xl leading-none text-gold" aria-hidden="true">“</span>
          <blockquote class="mt-2 leading-[1.75] text-ink/85">{r.text}</blockquote>
          <figcaption class="mt-5 label-ink">{r.author}</figcaption>
        </figure>
      ))}
    </div>
  ) : (
    <p class="mt-6 text-cream/60">{T('reviews_empty')}</p>
  )}
</section>
