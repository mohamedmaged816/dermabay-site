---
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const addr = clinic.address[lang];
const year = new Date().getFullYear();
---
<footer class="mt-20 border-t border-olive/10 bg-olive text-cream">
  <div class="container-x grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-display text-2xl">{lang === 'ar' ? clinic.nameAr : clinic.name}</p>
      <p class="mt-2 text-cream/80">{clinic.tagline[lang]}</p>
      <a href={clinic.instagram} rel="noopener" target="_blank" class="mt-4 inline-block text-gold hover:underline">Instagram @dermabay.eg</a>
    </div>
    <address class="not-italic text-cream/90">
      <p class="eyebrow !text-gold">{T('contact_address')}</p>
      <p class="mt-2">{addr.line1}<br/>{addr.line2}<br/>{addr.city}, {addr.region}</p>
      <p class="mt-3"><a href={`tel:${clinic.phoneE164}`} class="hover:underline" dir="ltr">{clinic.phoneDisplay}</a></p>
      <p class="mt-3 text-sm text-cream/70">{clinic.hoursText[lang]}</p>
    </address>
    <div>
      <p class="eyebrow !text-gold">{T('footer_areas')}</p>
      <p class="mt-2 text-cream/90">{clinic.areasServed[lang].join(' · ')}</p>
      <nav class="mt-6 flex flex-wrap gap-x-4 gap-y-2 text-sm">
        <a href={localizePath('about', lang)} class="hover:underline">{T('nav_about')}</a>
        <a href={localizePath('reviews', lang)} class="hover:underline">{T('nav_reviews')}</a>
        <a href={localizePath('privacy', lang)} class="hover:underline">{T('footer_privacy')}</a>
      </nav>
    </div>
  </div>
  <div class="border-t border-cream/10 py-4 text-center text-xs text-cream/60">© {year} {clinic.name}. {T('footer_rights')}</div>
</footer>
