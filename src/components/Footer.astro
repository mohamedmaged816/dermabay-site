---
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
import Wordmark from './Wordmark.astro';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const addr = clinic.address[lang];
const year = new Date().getFullYear();
---
<footer class="mt-28 border-t border-cream/10">
  <div class="container-x grid gap-12 py-16 md:grid-cols-[auto_1fr_1fr]">
    <div>
      <Wordmark size={3.4} tone="cream" />
      <p class="mt-5 max-w-[220px] text-sm leading-relaxed text-cream/60">{clinic.tagline[lang]}</p>
    </div>
    <address class="not-italic">
      <p class="label">{T('contact_address')}</p>
      <p class="mt-3 leading-relaxed text-cream/85">{addr.line1}<br/>{addr.line2}<br/>{addr.city}, {addr.region}</p>
      <p class="mt-4"><a href={`tel:${clinic.phoneE164}`} class="text-cream hover:text-gold" dir="ltr">{clinic.phoneDisplay}</a></p>
      <p class="mt-3 text-sm text-cream/70">{clinic.hoursText[lang]}</p>
    </address>
    <div>
      <p class="label">{T('footer_areas')}</p>
      <p class="mt-3 leading-relaxed text-cream/85">{clinic.areasServed[lang].join(' · ')}</p>
      <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-xs font-medium uppercase tracking-[0.16em] text-cream/70">
        <a href={localizePath('about', lang)} class="hover:text-gold">{T('nav_about')}</a>
        <a href={localizePath('reviews', lang)} class="hover:text-gold">{T('nav_reviews')}</a>
        <a href={localizePath('privacy', lang)} class="hover:text-gold">{T('footer_privacy')}</a>
        <a href={clinic.instagram} rel="noopener" target="_blank" class="hover:text-gold">Instagram</a>
      </nav>
    </div>
  </div>
  <div class="border-t border-cream/10 py-5 text-center text-[11px] uppercase tracking-[0.2em] text-cream/65">© {year} {clinic.name} · {T('footer_rights')}</div>
</footer>
