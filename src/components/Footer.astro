---
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
import Logo from './Logo.astro';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const addr = clinic.address[lang];
const year = new Date().getFullYear();
---
<footer class="mt-32 border-t border-cream/10">
  <div class="container-x py-16">
    <Logo variant="horizontal" class="block w-full max-w-[720px] text-cream [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" />
    <p class="mt-4 label">{lang === 'ar' ? 'عيادة تجميل · نيو جيزة' : 'Aesthetic Clinic · New Giza'}</p>
    <div class="mt-14 grid gap-12 md:grid-cols-3">
      <address class="not-italic">
        <p class="label">{T('contact_address')}</p>
        <p class="mt-3 leading-relaxed text-cream/85">{addr.line1}<br/>{addr.line2}<br/>{addr.city}, {addr.region}</p>
      </address>
      <div>
        <p class="label">{T('contact_phone')}</p>
        <p class="mt-3"><a href={`tel:${clinic.phoneE164}`} class="font-display text-3xl text-cream hover:text-sand" dir="ltr">{clinic.phoneDisplay}</a></p>
        <p class="mt-2"><a href={`mailto:${clinic.email}`} class="text-cream/80 hover:text-sand">{clinic.email}</a></p>
        <p class="mt-3 text-sm text-cream/65">{clinic.hoursText[lang]}</p>
      </div>
      <div>
        <p class="label">{T('footer_areas')}</p>
        <p class="mt-3 leading-relaxed text-cream/85">{clinic.areasServed[lang].join(' · ')}</p>
        <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-cream/70">
          <a href={localizePath('about', lang)} class="hover:text-sand">{T('nav_about')}</a>
          <a href={localizePath('reviews', lang)} class="hover:text-sand">{T('nav_reviews')}</a>
          <a href={localizePath('privacy', lang)} class="hover:text-sand">{T('footer_privacy')}</a>
          <a href={clinic.instagram} rel="noopener" target="_blank" class="hover:text-sand">Instagram</a>
        </nav>
      </div>
    </div>
  </div>
  <div class="border-t border-cream/10 py-5 text-center text-[11px] uppercase tracking-[0.2em] text-cream/65">© {year} {clinic.name} · {T('footer_rights')}</div>
</footer>
