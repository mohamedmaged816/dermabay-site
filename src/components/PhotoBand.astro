---
import type { Lang } from '@/i18n/utils';
import Photo from './Photo.astro';
import { clinic } from '@/data/clinic';
const { lang, name = 'room-wide', label, title } = Astro.props as { lang: Lang; name?: string; label?: string; title?: string };
const l = label ?? (lang === 'ar' ? 'العيادة · ميديتاون، نيو جيزة' : 'The clinic · Meditown, New Giza');
const t = title ?? (lang === 'ar' ? 'غرف علاج هادية، أجهزة حديثة، وتعقيم بين كل عميل.' : 'Quiet treatment rooms, current-generation devices, sterilised between every patient.');
---
<section class="container-x mt-28 lg:!pe-0 lg:!max-w-[calc(72rem+((100vw-72rem)/2))] lg:!me-0">
  <div class="brass-ring relative overflow-hidden rounded-[36px] lg:rounded-e-none">
    <div class="h-[300px] sm:h-[560px]"><div class="-my-[10%] h-[120%]" data-parallax="0.1"><Photo {name} alt={lang === 'ar' ? 'غرفة علاج في ديرما باي' : 'A DermaBay treatment room'} class="h-full w-full object-cover" width={1800} height={1392} /></div></div>
    <div class="absolute inset-0 bg-gradient-to-t from-forest/95 via-forest/30 to-transparent"></div>
    <div class="beam" aria-hidden="true" style="animation-duration: 11s"></div>
    <div class="absolute inset-x-0 bottom-0 p-5 sm:p-12">
      <p class="label">{l}</p>
      <p class="font-display mt-2 max-w-2xl text-2xl leading-tight text-cream sm:text-5xl">{t}</p>
      <p class="mt-4 text-sm text-cream/70">{clinic.address[lang].line1} · {clinic.address[lang].line2}</p>
    </div>
  </div>
</section>
