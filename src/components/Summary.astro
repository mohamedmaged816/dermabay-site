---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
const { lang, text } = Astro.props as { lang: Lang; text: string };
---
<div class="container-x">
  <div class="panel relative overflow-hidden p-5 sm:p-9" data-summary>
    <span class="label-ink">{t(lang)('summary_label')}</span>
    <div class="hairline-gold mt-3"></div>
    <p class="mt-3 max-w-3xl text-[15px] leading-[1.75] text-ink sm:text-xl">{text}</p>
  </div>
</div>
