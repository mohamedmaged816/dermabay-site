---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { results } from '@/data/results';
import { clinic } from '@/data/clinic';
const { lang, service } = Astro.props as { lang: Lang; service?: string };
const T = t(lang);
const items = results.filter((r) => !service || r.service === service);
---
{items.length > 0 ? (
  <div class="grid gap-6 sm:grid-cols-2">
    {items.map((r) => (
      <figure class="panel overflow-hidden">
        <div class="grid grid-cols-2 gap-1 p-1">
          <div class="relative"><img src={r.before} alt={`${r.caption[lang]} – before`} loading="lazy" width="600" height="600" class="aspect-[4/5] w-full rounded-[24px] object-cover" /><span class="absolute bottom-3 start-3 rounded-full bg-forest/80 px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-cream">Before</span></div>
          <div class="relative"><img src={r.after} alt={`${r.caption[lang]} – after`} loading="lazy" width="600" height="600" class="aspect-[4/5] w-full rounded-[24px] object-cover" /><span class="absolute bottom-3 start-3 rounded-full bg-gold px-3 py-1 text-[10px] uppercase tracking-[0.2em] text-forest">After</span></div>
        </div>
        <figcaption class="px-6 pb-6 pt-3 text-sm text-ink/75">{r.caption[lang]}</figcaption>
      </figure>
    ))}
  </div>
) : (
  <div class="arch flex flex-col items-center justify-center border border-dashed border-cream/25 px-8 pb-10 pt-20 text-center">
    <p class="max-w-sm text-cream/70">{T('results_empty')}</p>
    <a href={clinic.instagram} target="_blank" rel="noopener" class="btn-outline mt-6">{T('results_ig')}</a>
  </div>
)}
