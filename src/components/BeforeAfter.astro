---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { results } from '@/data/results';
import { clinic } from '@/data/clinic';
const { lang, service } = Astro.props as { lang: Lang; service?: string };
const T = t(lang);
const items = results.filter((r) => !service || r.service === service);
---
{items.length > 0 ? (
  <div class="grid gap-6 sm:grid-cols-2">
    {items.map((r) => (
      <figure class="overflow-hidden rounded-2xl border border-olive/10 bg-white/60">
        <div class="grid grid-cols-2">
          <img src={r.before} alt={`${r.caption[lang]} – before`} loading="lazy" width="600" height="600" class="aspect-square w-full object-cover" />
          <img src={r.after} alt={`${r.caption[lang]} – after`} loading="lazy" width="600" height="600" class="aspect-square w-full object-cover" />
        </div>
        <figcaption class="p-4 text-sm text-ink/80">{r.caption[lang]}</figcaption>
      </figure>
    ))}
  </div>
) : (
  <div class="rounded-2xl border border-dashed border-olive/30 p-8 text-center">
    <p class="text-ink/70">{T('results_empty')}</p>
    <a href={clinic.instagram} target="_blank" rel="noopener" class="btn-ghost mt-4">{T('results_ig')}</a>
  </div>
)}
