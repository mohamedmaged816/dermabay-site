---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
---
<div class="actionbar" role="region" aria-label={T('book_whatsapp')}>
  <button type="button" data-book-open class="btn-terra justify-center whitespace-nowrap !py-3.5">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.5 3.5A11.9 11.9 0 0 0 12 0C5.4 0 .1 5.3.1 11.9c0 2.1.5 4.1 1.6 5.9L0 24l6.4-1.7a11.9 11.9 0 0 0 5.6 1.4c6.6 0 11.9-5.3 11.9-11.9 0-3.2-1.2-6.2-3.4-8.3zM12 21.7c-1.8 0-3.5-.5-5-1.4l-.4-.2-3.8 1 1-3.7-.2-.4A9.8 9.8 0 0 1 2.1 12C2.1 6.5 6.5 2 12 2c2.6 0 5.1 1 7 2.9a9.8 9.8 0 0 1 2.9 7c0 5.5-4.5 9.8-9.9 9.8z"/></svg>
    {T('book_short')}
  </button>
  <a href={`tel:${clinic.phoneE164}`} class="btn-outline justify-center whitespace-nowrap !py-3.5" dir="ltr">{T('call')}</a>
</div>
