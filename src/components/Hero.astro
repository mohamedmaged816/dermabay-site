---
import type { Lang } from '@/i18n/utils';
import WhatsAppButton from './WhatsAppButton.astro';
import Leaves from './Leaves.astro';
import Logo from './Logo.astro';
interface Props { lang: Lang; eyebrow?: string; title: string; sub?: string; service?: string; secondaryHref?: string; secondaryLabel?: string; compact?: boolean; wordmark?: boolean; }
const { lang, eyebrow, title, sub, service, secondaryHref, secondaryLabel, compact = false, wordmark = false } = Astro.props;
---
<section class={`relative overflow-hidden ${compact ? 'pb-14 pt-10' : 'pb-24 pt-14 sm:pb-32 sm:pt-20'}`}>
  <Leaves opacity={0.6} />
  <div class="container-x relative">
    <div class={`grid items-center gap-12 ${wordmark ? 'lg:grid-cols-[1.2fr_1fr]' : ''}`}>
      <div class="hero-in max-w-3xl">
        {eyebrow && <p class="label">{eyebrow}</p>}
        <h1 class={`font-display mt-6 text-cream ${compact ? 'text-[2.6rem] leading-[1.05] sm:text-6xl' : 'text-[3.4rem] leading-[0.98] sm:text-[5.6rem]'}`}>{title}</h1>
        {sub && <p class="mt-8 max-w-xl text-base leading-[1.85] text-cream/75 sm:text-lg">{sub}</p>}
        <div class="mt-10 flex flex-wrap items-center gap-3">
          <WhatsAppButton {lang} {service} />
          {secondaryHref && <a href={secondaryHref} class="btn-outline">{secondaryLabel}</a>}
        </div>
      </div>
      {wordmark && (
        <div class="hidden justify-end lg:flex">
          <div class="arch relative flex h-[460px] w-[340px] items-center justify-center border border-sand/30 bg-forest-deep/70 shadow-[0_40px_80px_-30px_rgba(0,0,0,.6)]">
            <div class="absolute inset-3 arch border border-sand/15"></div>
            <Logo variant="stacked" class="w-[200px] text-sand [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
