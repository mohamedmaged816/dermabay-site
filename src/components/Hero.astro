---
import type { Lang } from '@/i18n/utils';
import WhatsAppButton from './WhatsAppButton.astro';
import Leaves from './Leaves.astro';
import Wordmark from './Wordmark.astro';
interface Props { lang: Lang; eyebrow?: string; title: string; sub?: string; service?: string; secondaryHref?: string; secondaryLabel?: string; compact?: boolean; wordmark?: boolean; }
const { lang, eyebrow, title, sub, service, secondaryHref, secondaryLabel, compact = false, wordmark = false } = Astro.props;
---
<section class={`relative overflow-hidden ${compact ? 'pb-14 pt-10' : 'pb-24 pt-16 sm:pb-32 sm:pt-24'}`}>
  <Leaves opacity={0.55} />
  <div class="container-x relative">
    <div class={`grid items-end gap-10 ${wordmark ? 'lg:grid-cols-[1fr_auto]' : ''}`}>
      <div class="max-w-3xl">
        {eyebrow && <p class="label">{eyebrow}</p>}
        <h1 class={`font-display mt-5 text-cream ${compact ? 'text-4xl leading-[1.05] sm:text-5xl' : 'text-5xl leading-[0.98] sm:text-7xl'}`}>{title}</h1>
        {sub && <p class="mt-7 max-w-xl text-base leading-[1.8] text-cream/75 sm:text-lg">{sub}</p>}
        <div class="mt-9 flex flex-wrap items-center gap-3">
          <WhatsAppButton {lang} {service} />
          {secondaryHref && <a href={secondaryHref} class="btn-outline">{secondaryLabel}</a>}
        </div>
      </div>
      {wordmark && (
        <div class="hidden lg:block">
          <div class="arch flex h-[420px] w-[300px] items-end justify-center border border-cream/20 bg-forest-deep/60 pb-10 shadow-2xl">
            <Wordmark size={5.2} tone="cream" />
          </div>
        </div>
      )}
    </div>
  </div>
</section>
