---
import { getCollection } from 'astro:content';
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import Photo from './Photo.astro';
import Topo from './Topo.astro';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const services = (await getCollection('services', (e) => e.data.lang === lang)).sort((a, b) => a.data.order - b.data.order);
const img = (slug: string) => ({ 'laser-hair-removal': 'handpiece-portrait', 'fractional-laser-scars': 'device-portrait', 'laser-skin-rejuvenation': 'device-portrait', 'pigmentation-melasma': 'device-portrait' } as Record<string, string>)[slug] ?? 'room-portrait';
---
<section class="relative mt-28 overflow-hidden" id="treatments">
  <Topo />
  <div class="container-x relative">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div>
        <p class="label">{T('nav_services')}</p>
        <h2 class="font-display mt-3 text-3xl text-cream sm:text-5xl">{T('home_services_title')}</h2>
      </div>
      <p class="max-w-sm text-cream/65">{T('home_services_sub')}</p>
    </div>
    <div class="mt-10 grid gap-12 lg:grid-cols-[1.1fr_1fr]">
      <div data-tx-list>
        {services.map((s, i) => (
          <a href={localizePath(`services/${s.data.slug}`, lang)} class={`tx-row ${i === 0 ? 'is-active' : ''}`} data-tx={i}>
            <span class="font-display text-2xl text-sand">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="font-display block text-[1.9rem] leading-[1.05] sm:text-[2.4rem]">{s.data.title}</span>
              <span class="mt-1 block text-[11px] font-semibold uppercase tracking-[0.22em] text-cream/55">{s.data.sessions}</span>
            </span>
            <svg class="tx-arrow h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </a>
        ))}
      </div>
      <div class="tx-preview hidden lg:block">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[32px] border border-sand/20 bg-forest-deep">
          {services.map((s, i) => (
            <div class={`tx-pane ${i === 0 ? 'is-active' : ''}`} data-tx-pane={i}>
              <Photo name={img(s.data.slug)} alt="" class="absolute inset-0 h-full w-full object-cover" width={1200} height={1500} />
              <div class="absolute inset-0 bg-gradient-to-t from-forest-deep via-forest-deep/30 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-8">
                <p class="label">{String(i + 1).padStart(2, '0')} · {s.data.title}</p>
                <p class="mt-3 leading-[1.75] text-cream/85">{s.data.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
