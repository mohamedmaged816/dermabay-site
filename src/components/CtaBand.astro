---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import WhatsAppButton from './WhatsAppButton.astro';
import { clinic } from '@/data/clinic';
const { lang, service } = Astro.props as { lang: Lang; service?: string };
const T = t(lang);
---
<section class="container-x mt-20">
  <div class="rounded-3xl bg-olive px-6 py-12 text-cream sm:px-12">
    <h2 class="font-display text-3xl sm:text-4xl">{T('cta_title')}</h2>
    <p class="mt-3 max-w-xl text-cream/80">{T('cta_sub')}</p>
    <div class="mt-6 flex flex-wrap gap-3">
      <WhatsAppButton {lang} {service} />
      <a href={`tel:${clinic.phoneE164}`} class="btn-ghost !border-cream/40 !text-cream" dir="ltr">{T('call')} {clinic.phoneDisplay}</a>
    </div>
  </div>
</section>
