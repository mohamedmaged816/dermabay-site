---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import WhatsAppButton from './WhatsAppButton.astro';
import Logo from './Logo.astro';
import Leaves from './Leaves.astro';
import { clinic } from '@/data/clinic';
const { lang, service } = Astro.props as { lang: Lang; service?: string };
const T = t(lang);
---
<section class="container-x mt-28">
  <div class="relative overflow-hidden rounded-[28px] bg-sand px-6 py-10 text-ink sm:rounded-[36px] sm:px-14 sm:py-16">
    <Leaves opacity={0.18} flip />
    <div class="relative grid items-center gap-12 md:grid-cols-[1fr_auto]">
      <div>
        <p class="label-ink">{T('book_whatsapp')}</p>
        <h2 class="font-display mt-4 text-4xl text-forest sm:text-6xl">{T('cta_title')}</h2>
        <p class="mt-5 max-w-md leading-[1.8] text-ink/75">{T('cta_sub')}</p>
        <div class="mt-9 flex flex-wrap gap-3">
          <WhatsAppButton {lang} {service} tone="forest" />
          <a href={`tel:${clinic.phoneE164}`} class="btn-outline-ink" dir="ltr">{T('call')} {clinic.phoneDisplay}</a>
        </div>
      </div>
      <Logo variant="stacked" class="hidden w-[180px] text-terra md:block [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" />
    </div>
  </div>
</section>
