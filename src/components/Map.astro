---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import { clinic } from '@/data/clinic';
const { lang } = Astro.props as { lang: Lang };
const q = encodeURIComponent('DermaBay Aesthetic Clinic, Meditown, NewGiza Health Park');
const src = clinic.geo
  ? `https://www.google.com/maps?q=${clinic.geo.lat},${clinic.geo.lng}&z=16&output=embed`
  : `https://www.google.com/maps?q=${q}&z=15&output=embed`;
---
<div class="overflow-hidden rounded-[28px] border border-cream/15">
  <iframe title="Map" src={src} width="100%" height="340" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="border:0; filter: saturate(.6) contrast(1.05)"></iframe>
  <div class="flex items-center justify-between gap-3 bg-forest-deep p-4 text-sm">
    <span class="text-cream/70">{clinic.address[lang].line1}, {clinic.address[lang].line2}</span>
    <a href={clinic.mapsUrl} target="_blank" rel="noopener" class="font-medium uppercase tracking-[0.14em] text-gold hover:text-cream">{t(lang)('directions')}</a>
  </div>
</div>
