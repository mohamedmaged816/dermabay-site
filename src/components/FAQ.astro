---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
const { lang, faqs, title } = Astro.props as { lang: Lang; faqs: { q: string; a: string }[]; title?: string };
---
<section class="container-x mt-24">
  <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div class="relative overflow-hidden">
      <div class="qa-mark pointer-events-none select-none" aria-hidden="true"></div>
      <h2 class="font-display -mt-4 text-2xl text-cream sm:-mt-6 sm:text-4xl">{title ?? t(lang)('faq_title')}</h2>
    </div>
    <div class="divide-y divide-cream/10 border-y border-cream/10">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-5 text-base text-cream sm:text-lg">
            <span class="leading-snug">{f.q}</span>
            <span class="mt-1 shrink-0 text-sand transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-4 max-w-2xl leading-[1.8] text-cream/70">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
