---
import type { Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
const { lang, faqs, title } = Astro.props as { lang: Lang; faqs: { q: string; a: string }[]; title?: string };
---
<section class="container-x mt-16">
  <h2 class="font-display text-3xl text-olive">{title ?? t(lang)('faq_title')}</h2>
  <div class="mt-6 divide-y divide-olive/10 rounded-2xl border border-olive/10 bg-white/50">
    {faqs.map((f) => (
      <details class="group p-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-olive">
          <span>{f.q}</span>
          <span class="text-gold transition group-open:rotate-45" aria-hidden="true">+</span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink/85">{f.a}</p>
      </details>
    ))}
  </div>
</section>
