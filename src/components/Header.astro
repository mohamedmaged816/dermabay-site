---
import { localizePath, type Lang } from '@/i18n/utils';
import { t } from '@/i18n/ui';
import LanguageSwitch from './LanguageSwitch.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { clinic } from '@/data/clinic';
const { lang } = Astro.props as { lang: Lang };
const T = t(lang);
const nav: [string, string][] = [
  ['services', T('nav_services')], ['results', T('nav_results')], ['offers', T('nav_offers')], ['guide', T('nav_guide')], ['new-giza-dermatologist', T('nav_location')], ['contact', T('nav_contact')],
];
---
<header class="sticky top-0 z-40 border-b border-cream/10 bg-forest/85 backdrop-blur-md">
  <div class="container-x flex h-[72px] items-center justify-between gap-4">
    <a href={localizePath('/', lang)} class="flex items-center gap-3" aria-label={clinic.name}>
      <span class="font-display text-[22px] uppercase tracking-[0.22em] text-cream" dir="ltr" style="font-family: var(--font-display)">Dermabay</span>
      {lang === 'ar' && <span class="hidden text-sm text-cream/70 sm:inline">{clinic.nameAr}</span>}
    </a>
    <nav class="hidden items-center gap-7 text-[13px] font-medium uppercase tracking-[0.14em] text-cream/80 lg:flex" aria-label="Main">
      {nav.map(([slug, label]) => <a href={localizePath(slug, lang)} class="hover:text-gold">{label}</a>)}
    </nav>
    <div class="flex items-center gap-2">
      <LanguageSwitch {lang} />
      <span class="hidden sm:block"><WhatsAppButton {lang} small /></span>
      <details class="relative lg:hidden">
        <summary class="list-none cursor-pointer rounded-full border border-cream/30 p-2.5 text-cream" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M3 6h14M3 10h14M3 14h14"/></svg>
        </summary>
        <nav class="absolute end-0 mt-3 w-64 rounded-3xl border border-cream/10 bg-forest-deep p-3 shadow-2xl" aria-label="Mobile">
          {nav.map(([slug, label]) => <a href={localizePath(slug, lang)} class="block rounded-2xl px-4 py-3 text-sm font-medium uppercase tracking-[0.12em] text-cream hover:bg-cream/10">{label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>
